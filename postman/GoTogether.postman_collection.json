              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_Id\": 0,\n  \"driverId\": {{driverId}},\n  \"make\": \"Honda\",\n  \"model\": \"City\",\n  \"plateNumber\": \"{{plateNumber}}\",\n  \"color\": \"White\",\n  \"capacity\": 4\n}"
            },
            "url": "{{vehicleServiceUrl}}/gotogether/vehicle"
          }
        },
        {
          "name": "Update vehicle",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicle_Id\": {{vehicleId}},\n  \"driverId\": {{driverId}},\n  \"make\": \"Honda\",\n  \"model\": \"City\",\n  \"plateNumber\": \"{{plateNumber}}\",\n  \"color\": \"White\",\n  \"capacity\": 4\n}"
            },
            "url": "{{vehicleServiceUrl}}/gotogether/vehicle/{{vehicleId}}"
          }
        },
        {
          "name": "Delete vehicle",
          "request": {
            "method": "DELETE",
            "url": "{{vehicleServiceUrl}}/gotogether/vehicle/{{vehicleId}}"
          }
        }
      ]
    }
  ]
}
